# Copy to .env (git-ignored). EVERY variable is optional: self-hosted experiments need none of them.
# Never put production keys here - use a personal/test project.

# Cloud baselines only (models marked `external: true`, which also need --allow-cloud).
# Free-tier Gemini content may be used by Google to improve its products and human-reviewed.
GEMINI_API_KEY=

# Only for gated Hugging Face checkpoints (IndicConformer, Indic Parler-TTS, Gemma 3, Llama).
HF_TOKEN=

OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1

# Optional: keep model weights inside the lab instead of the shared ~/.cache/huggingface
# HF_HOME=./.hf-cache
